rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Troque pelo(s) e-mail(s) de quem pode usar o painel
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['SEU_EMAIL_AQUI'];
    }

    match /codes/{code} {
      // O app consulta um código pelo número exato (não consegue listar todos)
      allow get: if true;
      allow list, create, delete: if isAdmin();

      // O app só pode gravar o aparelho na primeira ativação
      allow update: if isAdmin() || (
        resource.data.get('deviceId', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId', 'activatedAt', 'deviceModel'])
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() < 40
      );
    }
  }
}
