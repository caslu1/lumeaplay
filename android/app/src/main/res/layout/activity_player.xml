<?xml version="1.0" encoding="utf-8"?>
<!-- Player do LumeaPlay: vídeo + painel próprio (ao vivo, filmes, séries e Playback) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/pv"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ícone grande de pausa (filmes / séries / Playback) -->
    <ImageView
        android:id="@+id/bigState"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="center"
        android:background="@drawable/circle_big"
        android:padding="24dp"
        android:src="@drawable/ic_pause"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bufTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="76dp"
        android:background="@drawable/pill_bg"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="#E6E9F0"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/err"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card_bg"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxWidth="460dp"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- painel (aparece ao apertar uma tecla e some sozinho) -->
    <FrameLayout
        android:id="@+id/ui"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- topo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="top"
            android:background="@drawable/grad_top"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingTop="26dp"
            android:paddingEnd="40dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/kind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_live"
                        android:letterSpacing="0.1"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/qual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/badge_dim"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:textColor="#E6E9F0"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/topTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxWidth="600dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/topSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxWidth="600dp"
                    android:singleLine="true"
                    android:textColor="#A3A9B5"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pill_bg"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="#C9CDD6"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- rodapé -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/grad_bottom"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="70dp"
            android:paddingEnd="40dp"
            android:paddingBottom="26dp">

            <!-- AO VIVO: logo + canal + agora / a seguir -->
            <LinearLayout
                android:id="@+id/livePane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="70dp"
                    android:background="@drawable/card_bg">

                    <TextView
                        android:id="@+id/logoTxt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="#5C6270"
                        android:textSize="22sp" />

                    <ImageView
                        android:id="@+id/logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:textColor="#3B82F6"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/chName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="480dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nowTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#E6E9F0"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/nowBar"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="8dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/seek_progress" />

                    <TextView
                        android:id="@+id/nextTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#8B919E"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- FILMES / SÉRIES / PLAYBACK: barra de tempo + controles -->
            <LinearLayout
                android:id="@+id/vodPane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/seekWrap"
                    android:layout_width="match_parent"
                    android:layout_height="16dp">

                    <ProgressBar
                        android:id="@+id/seek"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_gravity="center_vertical"
                        android:max="1000"
                        android:progressDrawable="@drawable/seek_progress" />

                    <View
                        android:id="@+id/knob"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/circle_white" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/posTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/bRew"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/circle_dim"
                            android:padding="12dp"
                            android:src="@drawable/ic_rew" />

                        <ImageView
                            android:id="@+id/bPlay"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="18dp"
                            android:layout_marginEnd="18dp"
                            android:background="@drawable/circle_white"
                            android:padding="16dp"
                            android:src="@drawable/ic_pause"
                            android:tint="#0A0C10" />

                        <ImageView
                            android:id="@+id/bFwd"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/circle_dim"
                            android:padding="12dp"
                            android:src="@drawable/ic_ffwd" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/durTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:textColor="#A3A9B5"
                        android:textSize="14sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- dicas das teclas -->
            <TextView
                android:id="@+id/hints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#8B919E"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
